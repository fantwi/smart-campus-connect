APP_NAME="UCC Campus Connect"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://campus-connect.example.edu

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smart_campus
DB_USERNAME=smart_campus_app
DB_PASSWORD=replace-with-a-strong-unique-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.edu
MAIL_PORT=587
MAIL_USERNAME=replace-with-mail-username
MAIL_PASSWORD=replace-with-mail-password
MAIL_FROM_ADDRESS=campus-connect@example.edu
MAIL_FROM_NAME="UCC Campus Connect"

# Optional identity providers. Leave blank to hide them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CHATGPT_SIGN_IN_URL=
CHATGPT_SIGN_IN_ALLOWED_HOSTS=chatgpt.com,openai.com

# Generate APP_KEY during deployment with: php artisan key:generate
# Replace every example host and placeholder secret before starting production.
