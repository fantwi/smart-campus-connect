APP_NAME="UCC Campus Connect"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smart_campus
DB_USERNAME=smart_campus_app
DB_PASSWORD=change-this-local-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

VITE_APP_NAME="${APP_NAME}"

# Optional identity providers. Leave blank to hide them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CHATGPT_SIGN_IN_URL=
CHATGPT_SIGN_IN_ALLOWED_HOSTS=chatgpt.com,openai.com

# Server-side Campus AI. Never expose this key through a VITE_ variable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional secondary Campus AI provider, used when OpenAI is unavailable.
XAI_API_KEY=
XAI_MODEL=grok-4.5
XAI_BASE_URL=https://api.x.ai/v1
